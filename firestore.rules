rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to verify if the user is an admin in 'admin' or 'admins' collection
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/admin/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.rol == 'admin') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin collection:
    // Read: authenticated user can only read their own admin record to verify status
    // Write: strictly forbidden from frontend (managed only via Firebase Console or Backend Admin SDK)
    match /admin/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Admins collection (legacy fallback):
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Productos collection:
    // Public read: anyone (including anonymous clients on public menu) can read the dishes
    // Write: only verified administrators can create, update, or delete products
    match /productos/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categorias collection (sections):
    // Public read: anyone can read menu sections
    // Write: only verified administrators can create, update, or delete sections
    match /categorias/{categoriaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Ventas collection (sales records):
    // Strictly accessible ONLY by authenticated administrators with rol == 'admin'
    match /ventas/{ventaId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Gastos collection (operating expenses):
    // Strictly accessible ONLY by authenticated administrators with rol == 'admin'
    match /gastos/{gastoId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
